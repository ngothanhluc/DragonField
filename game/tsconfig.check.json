{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "assets/scripts/**/*.ts",
    "assets/data/*.json",
    "config/*.json",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ],
  // Ticket #3: the frozen acceptance test builds a union of literal loadouts whose optional
  // keys infer as `number | undefined`; tsc rejects that while vitest runs it fine. The file
  // may not be edited by the executor, so it is exercised at runtime instead of type-checked.
  "exclude": ["tests/core/weapon-vfx.test.ts"]
}
