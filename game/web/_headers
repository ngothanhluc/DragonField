# Cocos puts a hash in engine file names → they can be cached forever.
/cocos-js/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else (index.html, settings, uuid-named asset bundles) keeps its name across builds:
# the browser always revalidates (ETag → 304), so a new deploy takes effect immediately.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
