  "private": true,
  "scripts": {
    "check": "bun run check:config && bun run typecheck && bun run test && bun run lint",
    "check:config": "bun run scripts/gen-tuning.ts --check",
    "gen": "bun run scripts/gen-tuning.ts",
    "gen:anim": "bun run scripts/gen-animations.ts",
    "gen:elites": "bun run scripts/gen-elites.ts",
    "gen:splitlings": "bun run scripts/gen-splitlings.ts",
    "stage:art": "bun run scripts/stage-m6-assets.ts",
    "stage:m9": "bun run scripts/stage-m9-monsters.ts",
    "stage:audio": "bun run scripts/stage-m8-audio.ts",
    "stage:gen": "bun run scripts/stage-gemini-art.ts",
    "build:room": "bun run scripts/build-room.ts",
    "gen:rooms": "bun run scripts/generate-rooms.ts",
    "build:dev-room": "bun run scripts/build-dev-room.ts",
    "prep:refs": "bun run scripts/prep-gemini-refs.ts",
    "remove:watermark": "bun x gwr remove",
    "fix:font": "bun run scripts/fix-font-spacing.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"assets/scripts/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"assets/scripts/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{json,md}\"",
    "deploy:prepare": "bun run scripts/prepare-deploy.ts",
    "deploy": "bun run check && bun run deploy:prepare && wrangler deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@pilio/gemini-watermark-remover": "^1.0.46",
    "@types/node": "^26.6.6",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.164.0"
  }
}
