#!/bin/sh
# Tạo symlink từ ~/.config/herdr-core/templates/ tới các template hc trong repo.
# hc chỉ đọc template ở thư mục global; bản gốc nằm trong .claude/hc-templates/.
# Chạy lại an toàn (idempotent). Template có cùng tên mà không phải symlink thì giữ nguyên và báo.
set -eu
root=$(git rev-parse --show-toplevel)
dest=${HC_TEMPLATES_DIR:-$HOME/.config/herdr-core/templates}
mkdir -p "$dest"
for src in "$root"/.claude/hc-templates/*.md; do
  name=$(basename "$src")
  target="$dest/$name"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "bỏ qua $name: $target đã tồn tại và không phải symlink" >&2
    continue
  fi
  ln -sfn "$src" "$target"
  echo "$name → $target"
done
