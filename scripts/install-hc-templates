#!/bin/sh
# Copy this repo's hc templates into ~/.config/herdr-core/templates/ as real files.
# hc only reads templates from that global directory; the source lives in .claude/hc-templates/.
# Copies, not symlinks: a symlink ties every repo on the machine to whichever clone it points at.
# Safe to rerun: an identical file is left alone; a different file or a symlink is replaced and reported.
set -eu
root=$(git rev-parse --show-toplevel)
dest=${HC_TEMPLATES_DIR:-$HOME/.config/herdr-core/templates}
mkdir -p "$dest"
for src in "$root"/.claude/hc-templates/*.md; do
  name=$(basename "$src")
  target="$dest/$name"
  if [ -f "$target" ] && [ ! -L "$target" ] && cmp -s "$src" "$target"; then
    continue
  fi
  if [ -L "$target" ]; then
    echo "replacing symlink $name (was → $(readlink "$target"))"
    rm "$target"
  elif [ -e "$target" ]; then
    echo "updating $name"
  else
    echo "installing $name"
  fi
  cp "$src" "$target"
done
