#!/bin/sh
# Symlink the hc templates in the repo into ~/.config/herdr-core/templates/.
# hc only reads templates from the global directory; the source lives in .claude/hc-templates/.
# Safe to rerun (idempotent). A same-named template that is not a symlink is left alone and reported.
set -eu
root=$(git rev-parse --show-toplevel)
dest=${HC_TEMPLATES_DIR:-$HOME/.config/herdr-core/templates}
mkdir -p "$dest"
for src in "$root"/.claude/hc-templates/*.md; do
  name=$(basename "$src")
  target="$dest/$name"
  if [ -e "$target" ] && [ ! -L "$target" ]; then
    echo "skipping $name: $target already exists and is not a symlink" >&2
    continue
  fi
  ln -sfn "$src" "$target"
  echo "$name → $target"
done
