#!/bin/sh
# Run a command as the GitHub account that owns the repo, without switching the machine's active account.
# The account is the owner in the `origin` remote URL (override with AS_OWNER=<login>). The token only lives in the child process env,
# never on the command line (hc ls shows command lines).
#   scripts/as-owner gh pr create ...
#   scripts/as-owner scripts/pr-wait 12 --until green --allow-no-checks
set -eu
owner=${AS_OWNER:-$(git remote get-url origin 2>/dev/null | sed -E 's#^(https://[^/]+/|git@[^:]+:|ssh://git@[^/]+/)##; s#/.*##')}
[ -n "$owner" ] || { echo "as-owner: cannot read the owner from the origin remote; set AS_OWNER" >&2; exit 2; }
token=$(gh auth token -u "$owner" 2>/dev/null) || {
  echo "as-owner: gh is not logged in as account $owner (gh auth login)" >&2
  exit 2
}
GH_TOKEN=$token exec "$@"
