#!/usr/bin/env python3
"""resolve-models: pick the newest model in each role's line (models.json).

  scripts/resolve-models            # print the role → model table, write the resolved file
  scripts/resolve-models --get ROLE # print only one role's full ID (used by oc-agent)

Sources: `opencode models` (models available in the package) + models.dev (release dates, prices).
Results are written to <git-common-dir>/kol-auto/models.resolved.json, shared by all worktrees.
A `changed:` line appears when a role's model differs from the previous run.
Exit 0 when every role has a model, 1 when a role found no matching model.
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
import time
from pathlib import Path

MODELS_DEV = "https://models.dev/api.json"
CACHE_SECONDS = 6 * 3600


def git(*args: str) -> str:
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout.strip()


def state_dir() -> Path:
    d = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir")) / "kol-auto"
    d.mkdir(parents=True, exist_ok=True)
    return d


def models_dev(cache: Path) -> dict:
    if cache.exists() and time.time() - cache.stat().st_mtime < CACHE_SECONDS:
        return json.loads(cache.read_text())
    try:  # curl instead of urllib: the python.org build on macOS lacks a CA store
        data = subprocess.run(["curl", "-fsSL", "--max-time", "20", MODELS_DEV],
                              check=True, capture_output=True).stdout
        parsed = json.loads(data)
        cache.write_bytes(data)
        return parsed
    except Exception as e:  # network error: use the old cache if present, otherwise sort by name
        print(f"warn: could not download models.dev ({e}); using the old cache or sorting by name", file=sys.stderr)
        return json.loads(cache.read_text()) if cache.exists() else {}


def available(provider: str) -> list[str]:
    out = subprocess.run(["opencode", "models"], check=True, capture_output=True, text=True).stdout
    prefix = provider + "/"
    return [line[len(prefix):].strip() for line in out.splitlines() if line.startswith(prefix)]


def natural(s: str) -> list:
    return [int(t) if t.isdigit() else t for t in re.split(r"(\d+)", s)]


def newest(ids: list[str], meta: dict) -> str | None:
    if not ids:
        return None
    return max(ids, key=lambda i: (meta.get(i, {}).get("release_date", ""), natural(i)))


def cost(meta: dict, mid: str) -> str:
    c = meta.get(mid, {}).get("cost") or {}
    if "input" not in c:
        return "price ?"
    return f"${c['input']}/${c.get('output', '?')} per 1M in/out"


def main() -> int:
    sd = state_dir()
    resolved_path = sd / "models.resolved.json"
    prev = json.loads(resolved_path.read_text()) if resolved_path.exists() else {}

    if len(sys.argv) == 3 and sys.argv[1] == "--get":
        role = sys.argv[2]
        if role in prev.get("roles", {}):
            print(prev["roles"][role])
            return 0
        print(f"resolve-models: role {role} not resolved yet; run scripts/resolve-models first", file=sys.stderr)
        return 1

    root = Path(git("rev-parse", "--show-toplevel"))
    cfg = json.loads((root / "models.json").read_text())
    dev = models_dev(sd / "models.dev.json")
    provider = cfg["provider"]
    meta = dev.get(provider, {}).get("models", {})
    ids = [i for i in available(provider) if not i.endswith("-free")]

    roles: dict[str, str] = {}
    missing = []
    for role, spec in cfg["roles"].items():
        pick = newest([i for i in ids if re.search(spec["match"], i)], meta)
        if not pick:
            missing.append(role)
            print(f"{role}: NO model matches {spec['match']} in {provider}")
            continue
        full = f"{provider}/{pick}"
        roles[role] = full
        date = meta.get(pick, {}).get("release_date", "?")
        print(f"{role}: {full} (released {date}, {cost(meta, pick)})")
        old = prev.get("roles", {}).get(role)
        if old and old != full:
            old_id = old.split("/", 1)[1]
            print(f"changed: {role} {old} ({cost(meta, old_id)}) → {full} ({cost(meta, pick)})")

    orch = cfg.get("orchestrator")
    if orch:
        ometa = dev.get(orch["models_dev_provider"], {}).get("models", {})
        latest = newest([i for i in ometa if re.search(orch["match"], i)], ometa)
        if latest:
            print(f"orchestrator-latest: {latest} (released {ometa[latest].get('release_date', '?')})")

    resolved_path.write_text(json.dumps({"resolved_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "roles": roles}, indent=2))
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main())
