#!/usr/bin/env python3
"""merge-lock: a merge lock shared by owners running in parallel (full-send-spec).

  scripts/merge-lock acquire   # block until the lock is taken (max 2 hours), exit 0
  scripts/merge-lock release   # release the lock if you hold it
  scripts/merge-lock status    # print who holds it

The lock is the directory <git-common-dir>/agent-auto/merge.lock, holding a `holder` file with $HC_TERMINAL_ID.
If the holding terminal is no longer alive (hc get reports not_found or it already exited), the lock is
treated as abandoned and is taken over, so an owner that dies midway does not block the whole queue.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

POLL = 15
TIMEOUT = 2 * 3600


def lock_dir() -> Path:
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            check=True, capture_output=True, text=True).stdout.strip()
    d = Path(common) / "agent-auto"
    d.mkdir(parents=True, exist_ok=True)
    return d / "merge.lock"


def me() -> str:
    t = os.environ.get("HC_TERMINAL_ID")
    if not t:
        sys.exit("merge-lock: missing $HC_TERMINAL_ID (must run inside herdr-core)")
    return t


def holder(lock: Path) -> str | None:
    try:
        return (lock / "holder").read_text().strip()
    except OSError:
        return None


def alive(term: str) -> bool:
    r = subprocess.run(["hc", "get", term, "--json"], capture_output=True, text=True)
    if r.returncode != 0:
        return False
    try:
        return json.loads(r.stdout).get("exit_code") is None
    except json.JSONDecodeError:
        return True  # unreadable output means treat it as alive, to avoid stealing the lock by mistake


def acquire(lock: Path, who: str) -> int:
    start = time.time()
    while True:
        try:
            lock.mkdir()
            (lock / "holder").write_text(who)
            print(f"merge-lock: {who} holds the lock")
            return 0
        except FileExistsError:
            h = holder(lock)
            if h == who:
                print(f"merge-lock: {who} already holds the lock")
                return 0
            if h and not alive(h):
                print(f"merge-lock: {h} is no longer alive, taking over the lock", file=sys.stderr)
                shutil.rmtree(lock, ignore_errors=True)
                continue
            if time.time() - start > TIMEOUT:
                print(f"merge-lock: waited over 2 hours, {h} still holds the lock", file=sys.stderr)
                return 1
            time.sleep(POLL)


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in ("acquire", "release", "status"):
        print(__doc__, file=sys.stderr)
        return 2
    lock = lock_dir()
    cmd = sys.argv[1]
    if cmd == "status":
        print(holder(lock) or "empty")
        return 0
    who = me()
    if cmd == "acquire":
        return acquire(lock, who)
    h = holder(lock)
    if h and h != who:
        print(f"merge-lock: the lock belongs to {h}, not releasing", file=sys.stderr)
        return 1
    shutil.rmtree(lock, ignore_errors=True)
    print(f"merge-lock: {who} released the lock")
    return 0


if __name__ == "__main__":
    sys.exit(main())
