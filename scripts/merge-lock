#!/usr/bin/env python3
"""merge-lock: khoá merge dùng chung giữa các owner chạy song song (full-send-spec).

  scripts/merge-lock acquire   # chặn tới khi lấy được khoá (tối đa 2 giờ), exit 0
  scripts/merge-lock release   # nhả khoá nếu mình đang giữ
  scripts/merge-lock status    # in ai đang giữ

Khoá là thư mục <git-common-dir>/kol-auto/merge.lock, chứa file `holder` ghi $HC_TERMINAL_ID.
Terminal giữ khoá không còn sống (hc get báo not_found hoặc đã exit) thì khoá bị coi là
bỏ quên và được lấy lại, để một owner chết giữa chừng không chặn cả hàng đợi.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

POLL = 15
TIMEOUT = 2 * 3600


def lock_dir() -> Path:
    common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                            check=True, capture_output=True, text=True).stdout.strip()
    d = Path(common) / "kol-auto"
    d.mkdir(parents=True, exist_ok=True)
    return d / "merge.lock"


def me() -> str:
    t = os.environ.get("HC_TERMINAL_ID")
    if not t:
        sys.exit("merge-lock: thiếu $HC_TERMINAL_ID (phải chạy trong herdr-core)")
    return t


def holder(lock: Path) -> str | None:
    try:
        return (lock / "holder").read_text().strip()
    except OSError:
        return None


def alive(term: str) -> bool:
    r = subprocess.run(["hc", "get", term, "--json"], capture_output=True, text=True)
    if r.returncode != 0:
        return False
    try:
        return json.loads(r.stdout).get("exit_code") is None
    except json.JSONDecodeError:
        return True  # không đọc được thì coi như còn sống, tránh cướp khoá nhầm


def acquire(lock: Path, who: str) -> int:
    start = time.time()
    while True:
        try:
            lock.mkdir()
            (lock / "holder").write_text(who)
            print(f"merge-lock: {who} giữ khoá")
            return 0
        except FileExistsError:
            h = holder(lock)
            if h == who:
                print(f"merge-lock: {who} đã giữ khoá")
                return 0
            if h and not alive(h):
                print(f"merge-lock: {h} không còn sống, lấy lại khoá", file=sys.stderr)
                shutil.rmtree(lock, ignore_errors=True)
                continue
            if time.time() - start > TIMEOUT:
                print(f"merge-lock: chờ quá 2 giờ, {h} vẫn giữ khoá", file=sys.stderr)
                return 1
            time.sleep(POLL)


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in ("acquire", "release", "status"):
        print(__doc__, file=sys.stderr)
        return 2
    lock = lock_dir()
    cmd = sys.argv[1]
    if cmd == "status":
        print(holder(lock) or "trống")
        return 0
    who = me()
    if cmd == "acquire":
        return acquire(lock, who)
    h = holder(lock)
    if h and h != who:
        print(f"merge-lock: khoá đang thuộc {h}, không nhả", file=sys.stderr)
        return 1
    shutil.rmtree(lock, ignore_errors=True)
    print(f"merge-lock: {who} nhả khoá")
    return 0


if __name__ == "__main__":
    sys.exit(main())
