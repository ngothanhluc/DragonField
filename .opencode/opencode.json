{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "auto",
  "agents": {
    "auto": {
      "mode": "primary",
      "model": "{env:AUTO_OC_MODEL}"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "tdd",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "executor-rules",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "game-feel",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "game-ui-ux",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "level-design",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "performance-optimization",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "game-ai",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "roguelike",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "game-docs",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "audio-design",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "camera-systems",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "input-systems",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "physics-tuning",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "save-systems",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:git push *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:gh *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:scripts/as-owner *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git worktree *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git checkout *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git switch *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git rebase *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git reset *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git merge *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:hc run *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:opencode *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:claude *",
      "effect": "deny"
    }
  ]
}
